/* PCI premium home — hero shell, sections, white leaderboard, stats band. UI only. */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}

/* Hero shell: Islamabad photo pinned to the top, fading into the page background */
.site-main:has(> .pci-cinematic){padding-bottom:0}
.pci-cinematic{position:relative;isolation:isolate;color:var(--pci-text);background:var(--pci-bg);overflow:hidden;padding-bottom:clamp(40px,6vw,72px)}
.pci-cinematic::before{content:"";position:absolute;inset:0 0 auto;height:1000px;z-index:-2;background:linear-gradient(180deg,rgba(5,9,20,.86) 0%,rgba(5,9,20,.50) 26%,rgba(5,9,20,.20) 46%,rgba(5,9,20,.72) 76%,var(--pci-bg) 100%),url('/images/islamabad-dusk.webp') center 42%/cover no-repeat}
.pci-cinematic::after{content:"";position:absolute;inset:0 0 auto;height:1000px;z-index:-1;pointer-events:none;background:radial-gradient(ellipse 80% 55% at 50% 30%,transparent,rgba(5,9,20,.38))}
.pci-cinematic .container,.pci-home-white .container{width:var(--pci-wrap);max-width:none;margin-inline:auto;padding-inline:0}

/* Section typography */
.pci-overline{display:block;font-size:12px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--brand)}
.pci-cinematic .pci-overline{color:var(--pci-mint-soft)}
.pci-section-heading{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:32px}
.pci-section-heading h2{margin:10px 0 8px;font-size:clamp(1.5rem,2.4vw,1.85rem);font-weight:500;letter-spacing:-.015em;color:var(--ink)}
.pci-section-heading p{margin:0;max-width:56ch;font-size:15px;line-height:1.6;color:var(--ink-soft)}
.pci-text-link{font-size:14px;font-weight:500;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--border-strong);padding-bottom:2px;transition:color .2s,border-color .2s}
.pci-text-link:hover{color:var(--brand);border-color:var(--brand)}

/* White content */
.pci-home-white{background:#fff;color:var(--ink);padding:clamp(64px,8vw,104px) 0 clamp(64px,8vw,96px)}
.pci-leaderboard-section{padding:0}

/* Airy white table — original data-backed rankings remain unchanged. */
/* Leaderboard */
.pci-leaderboard-scroll{background:white;overflow-x:auto;border-top:1px solid var(--border);-webkit-overflow-scrolling:touch}
.pci-leaderboard-scroll:focus-visible{outline:2px solid var(--brand);outline-offset:4px}
.pci-leaderboard-table{width:100%;border-collapse:collapse;font-size:15px;color:var(--ink)}
.pci-leaderboard-table thead{background:transparent}
.pci-leaderboard-table th{padding:16px 14px;text-align:left;font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap;border-bottom:1px solid var(--border)}
.pci-leaderboard-table td{padding:16px 14px;border-bottom:1px solid #eef1f5;vertical-align:middle;background:transparent}
.pci-leaderboard-table .pci-col-num{text-align:right;font-variant-numeric:tabular-nums}
.pci-leaderboard-table tbody tr{transition:background .2s}
.pci-leaderboard-table tbody tr:hover{background:#f7f9fc}
.pci-table-rank{width:72px;white-space:nowrap;color:var(--ink-muted);font-variant-numeric:tabular-nums}
.pci-main-metric{font-weight:600;color:var(--ink)}
.pci-rank-gold,.pci-table-crown{color:#b8801c!important;font-weight:600}
.pci-table-crown{font-size:1.1rem;margin-left:8px;vertical-align:middle}
.pci-table-identity{display:inline-flex;align-items:center;gap:14px;color:var(--ink);text-decoration:none}
.pci-table-identity strong{font-weight:500;font-size:16px;letter-spacing:-.01em}
.pci-table-identity img,.pci-table-monogram{width:40px;height:40px;border-radius:50%;object-fit:cover;flex:none}
.pci-table-monogram{display:grid;place-items:center;background:var(--brand-soft);color:var(--brand);font-weight:600;font-size:14px}
.pci-category-chip{display:inline-block;padding:5px 12px;border-radius:999px;background:#f1f4f8;color:var(--ink-soft);font-size:12px;font-weight:500;white-space:nowrap}
.pci-profile-link{font-size:13px;font-weight:500;color:var(--ink);text-decoration:none;white-space:nowrap;border-bottom:1px solid transparent;transition:border-color .2s,color .2s}
.pci-profile-link:hover{color:var(--brand);border-color:var(--brand)}
.pci-updated-col{color:var(--ink-muted);font-size:13px;white-space:nowrap}
.pci-data-disclosure{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 24px;padding-top:18px;font-size:13px;color:var(--ink-muted)}
.pci-leaderboard-empty{text-align:center;padding:40px 24px;border:1px solid var(--border);border-radius:var(--r-md);background:#fff}
.pci-leaderboard-empty h3{margin:0;font-weight:500;color:var(--ink)}
.pci-leaderboard-empty p{margin:8px 0 0;color:var(--ink-soft)}

/* Stats band */
.pci-home-overview{padding-top:clamp(56px,7vw,88px)}
.pci-home-overview .pci-overline{margin-bottom:18px}
.pci-home-overview .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:0;background:var(--border);border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden}
.pci-home-overview .metric-grid .card{padding:28px 24px;border:0;border-radius:0;box-shadow:none;background:#fff}
.pci-home-overview .metric-value{font-size:clamp(1.5rem,2.4vw,1.9rem);font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:var(--ink)}
.pci-home-overview .metric-label{font-size:13px;font-weight:500;color:var(--ink-soft)}
.pci-home-overview .metric-note,.pci-home-overview .metric-grid .card small{font-size:12px;color:var(--ink-muted)}

@media(max-width:900px){.pci-leaderboard-table th:nth-child(7),.pci-leaderboard-table td:nth-child(7){display:none}.pci-home-overview .metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.pci-leaderboard-table th:nth-child(3),.pci-leaderboard-table td:nth-child(3),.pci-leaderboard-table th:nth-child(6),.pci-leaderboard-table td:nth-child(6){display:none}.pci-section-heading{align-items:flex-start}.pci-data-disclosure{flex-direction:column}.pci-leaderboard-table th,.pci-leaderboard-table td{padding:14px 10px}}
@media(prefers-reduced-motion:reduce){.pci-leaderboard-table tbody tr{transition:none}}

/* Legacy blocks kept verbatim from the previous stylesheet (category tiles / footer / extras). Remove only if unused elsewhere. */
.pci-categories{position:relative;padding:20px 0 15px}
.pci-categories-head,.pci-section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}
.pci-categories-head h2{color:white;font-size:clamp(1.3rem,2vw,1.8rem);margin:4px 0 3px;letter-spacing:-.03em}
.pci-categories-head p{color:#b8d4df;font-size:.86rem}
.pci-categories .pci-overline{color:#5cebd9}
.pci-categories .pci-text-link{color:#61edda}
.pci-category-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:11px}
.pci-category-tile{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:114px;border-radius:12px;border:1px solid #c9d6ea50;padding:12px 12px 13px;overflow:hidden;background:#17374a;color:#fff;box-shadow:0 8px 25px #020b1b65;transition:transform .2s,border-color .2s}
.pci-category-tile::before{content:"";position:absolute;inset:0;z-index:-1;opacity:.95;background:radial-gradient(circle at 80% 25%,#66d6cb60,transparent 55%),linear-gradient(130deg,#274c6e,#0a172b)}
.pci-category-tile[data-kind=vlog]::before{background:radial-gradient(circle at 35% 15%,#aec6a087,transparent 57%),linear-gradient(135deg,#284c55,#0a192d)}
.pci-category-tile[data-kind=news]::before{background:radial-gradient(circle at 65% 18%,#ad6cc99c,transparent 60%),linear-gradient(150deg,#4b274e,#14152d)}
.pci-category-tile[data-kind=faith]::before{background:radial-gradient(circle at 60% 20%,#c6a96d9f,transparent 60%),linear-gradient(150deg,#52604c,#102e2e)}
.pci-category-tile[data-kind=entertainment]::before{background:radial-gradient(circle at 70% 22%,#d74b7ca8,transparent 59%),linear-gradient(150deg,#611f42,#101228)}
.pci-category-tile[data-kind=tech]::before{background:radial-gradient(circle at 55% 18%,#4ba2eaa1,transparent 61%),linear-gradient(150deg,#144a70,#0a192e)}
.pci-category-tile[data-kind=lifestyle]::before{background:radial-gradient(circle at 70% 20%,#d7ad7fbd,transparent 61%),linear-gradient(150deg,#85533a,#261d2b)}
.pci-category-tile[data-kind=gaming]::before{background:radial-gradient(circle at 70% 18%,#9d63eaa8,transparent 61%),linear-gradient(150deg,#4c236f,#16162d)}
.pci-category-tile:hover,.pci-category-tile:focus-visible{transform:translateY(-4px);border-color:#31f5d8;color:#fff}
.pci-category-symbol{position:absolute;top:5px;right:13px;font-size:2.7rem;line-height:1;opacity:.58;font-weight:650;text-shadow:0 3px 8px #0009}
.pci-category-tile strong{position:relative;font-size:.83rem;line-height:1.24;letter-spacing:-.02em;max-width:90%;text-shadow:0 2px 10px #000}
.pci-category-next{position:absolute;right:8px;bottom:8px;font-size:.85rem;color:#9cf3e2}
.pci-category-await{border:1px dashed #94b3ba65;border-radius:14px;padding:25px;display:flex;justify-content:space-between;gap:10px;color:#d7eced}
.pci-category-await a{color:#70eddb}
.pci-home-extras{padding-top:42px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
.pci-explore-panel{background:linear-gradient(140deg,#edf8f7,#fff);border:1px solid #d1eae7;border-radius:17px;padding:28px;color:#0b2840;display:flex;flex-direction:column;gap:10px;min-height:205px}
.pci-explore-panel:hover{border-color:#11aea5;color:#0b2840}
.pci-explore-panel h2{font-size:1.5rem;color:#102c42}
.pci-explore-panel p{font-size:.87rem;color:#5b6b7e;max-width:440px}
.pci-explore-panel strong{font-size:.83rem;color:#008d87;margin-top:auto}
.pci-explore-panel-alt{background:linear-gradient(140deg,#f7f4fb,#fff);border-color:#e1daeb}
@media(max-width:1150px){.pci-category-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:740px){.pci-category-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.pci-category-tile{min-height:105px}.pci-categories-head,.pci-section-heading{align-items:flex-start}.pci-categories-head h2{font-size:1.45rem}.pci-categories .pci-text-link{font-size:.74rem}.pci-home-extras{grid-template-columns:1fr}}
@media(max-width:400px){.pci-category-tile{padding:11px}.pci-category-tile strong{font-size:.75rem}}
@media(prefers-reduced-motion:reduce){.pci-cinematic .ranking-wheel-card,.pci-category-tile{transition:none}}
.pci-footer .footer-grid{padding:28px 0;gap:25px}
.pci-footer h3{font-size:.86rem;font-weight:620;margin-bottom:6px}
.pci-footer p,.pci-footer a{font-size:.77rem;line-height:1.55}
.pci-footer a{padding:3px 0}
.pci-footer .footer-bottom{font-size:.69rem;padding:11px 0}
