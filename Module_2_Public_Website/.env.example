# Browser needs a public HTTPS API URL (must exactly match Module 1 PUBLIC_ORIGIN).
NEXT_PUBLIC_ADAPTER_API_URL=http://localhost:8080
# Next.js server-side data fetching uses this address; in Docker use host.docker.internal.
ADAPTER_INTERNAL_URL=http://localhost:8080
# Cloudflare Turnstile SITE key (public), never put the SECRET key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public site origin for canonical URLs. Use HTTPS for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
