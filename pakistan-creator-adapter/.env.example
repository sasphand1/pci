# Replace every CHANGE_ME placeholder before public deployment.
NODE_ENV=development
PORT=8080
DB_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3000
TRUST_PROXY=0
DATABASE_URL=postgresql://pci:pci_dev_only@localhost:5432/pci
REDIS_URL=redis://localhost:6379
YOUTUBE_API_KEY=
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_DAILY_SOFT_LIMIT=8000
SYNC_TIMEZONE=Asia/Karachi
SYNC_VIDEOS_PER_CHANNEL=50
PUBLIC_CACHE_TTL_SECONDS=300
# openssl rand -hex 32; MUST be 64 hex chars; never rotate without re-enrolling MFA
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX
# openssl rand -hex 32; cryptographic log pseudonym secret
LOG_HMAC_KEY=CHANGE_ME_64_HEX
# Cloudflare Turnstile keys. In production, required for guest and register forms.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# ONLY dev/testing, never permitted in production
DEV_BYPASS_TURNSTILE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.invalid
# Under production verify email via configured SMTP; console outbox is dev-only
WALL_MESSAGE_RETENTION_DAYS=7
ADMIN_SESSION_HOURS=8
WALL_SESSION_DAYS=7
ADVANCED_ANALYTICS_ENABLED=false
ML_RANKING_ENABLED=false
