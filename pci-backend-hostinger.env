# PCI - MODULE 1 - HOSTINGER BACKEND

NODE_ENV=production
PORT=8080
DB_PASSWORD=NOT_USED_BY_NEON_RUNTIME

PUBLIC_ORIGIN=https://darkcyan-wasp-393761.hostingersite.com
ADMIN_ORIGIN=https://primal-ivory-mouse-02.hostingersite.com/
APP_PUBLIC_URL=https://darkcyan-wasp-393761.hostingersite.com
TRUST_PROXY=1

# NEON POSTGRESQL
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-mute-silence-bam9vggn.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# UPSTASH REDIS
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@neat-dinosaur-202742.upstash.io:6379

# YOUTUBE
YOUTUBE_API_KEY=
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_DAILY_SOFT_LIMIT=8000
SYNC_TIMEZONE=Asia/Karachi
SYNC_VIDEOS_PER_CHANNEL=50
PUBLIC_CACHE_TTL_SECONDS=300

# SECURITY
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTER_KEY
LOG_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTER_KEY

# CLOUDFLARE TURNSTILE
TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_SECRET
TURNSTILE_EXPECTED_HOSTNAME=darkcyan-wasp-393761.hostingersite.com
DEV_BYPASS_TURNSTILE=false

# HOSTINGER SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@rackeltotechnologies.com
SMTP_PASS=YOUR_MAILBOX_PASSWORD
SMTP_FROM=info@rackeltotechnologies.com

# APPLICATION SETTINGS
WALL_MESSAGE_RETENTION_DAYS=7
ADMIN_SESSION_HOURS=8
WALL_SESSION_DAYS=7

ADVANCED_ANALYTICS_ENABLED=false
ML_RANKING_ENABLED=false