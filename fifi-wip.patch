diff --git a/Module_2_Public_Website/src/app/fifi.css b/Module_2_Public_Website/src/app/fifi.css
new file mode 100644
index 0000000..94f334e
--- /dev/null
+++ b/Module_2_Public_Website/src/app/fifi.css
@@ -0,0 +1,141 @@
+/* Fifi public design. Everything is scoped under .fx and prefixed fx-, so it cannot change the older pages. */
+.fx{--fx-bg:oklch(0.978 0.008 88);--fx-fg:oklch(0.245 0.035 166);--fx-card:oklch(0.997 0.003 88);--fx-primary:oklch(0.345 0.085 163);--fx-primary-light:oklch(0.43 0.095 161);--fx-on-primary:oklch(0.982 0.009 90);--fx-secondary:oklch(0.944 0.025 153);--fx-muted:oklch(0.949 0.011 91);--fx-muted-fg:oklch(0.49 0.026 161);--fx-gold:oklch(0.76 0.145 77);--fx-gold-soft:oklch(0.925 0.065 87);--fx-gold-fg:oklch(0.40 0.09 65);--fx-border:oklch(0.887 0.018 92);--fx-input:oklch(0.86 0.022 105);--fx-warn:oklch(0.55 0.19 27);--fx-radius:14px;--fx-shadow:0 12px 40px -24px oklch(0.28 0.055 165 / 22%);--fx-display:"Newsreader",Georgia,"Times New Roman",serif;--fx-sans:"DM Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
+ min-height:100vh;background:var(--fx-bg);color:var(--fx-fg);font-family:var(--fx-sans);font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
+.fx *,.fx *::before,.fx *::after{box-sizing:border-box}
+.fx a{color:inherit;text-decoration:none}.fx a:hover{color:var(--fx-primary)}
+.fx h1,.fx h2,.fx h3,.fx h4,.fx p,.fx ul,.fx ol,.fx figure{margin:0;padding:0}
+.fx ul,.fx ol{list-style:none}
+.fx img{display:block;max-width:100%}
+.fx button,.fx input,.fx select{font:inherit;color:inherit}
+.fx :focus-visible{outline:2px solid var(--fx-primary);outline-offset:2px}
+.fx-skip{position:absolute;left:-9999px;top:8px;background:var(--fx-primary);color:var(--fx-on-primary)!important;padding:8px 14px;border-radius:8px;z-index:100}
+.fx-skip:focus{left:8px}
+.fx-wrap{width:100%;max-width:1280px;margin:0 auto;padding:0 20px}
+@media(min-width:640px){.fx-wrap{padding:0 32px}}@media(min-width:1024px){.fx-wrap{padding:0 40px}}
+.fx-eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--fx-gold-fg)}
+.fx-display{font-family:var(--fx-display);font-weight:500;letter-spacing:-.03em;color:var(--fx-primary);line-height:1.04}
+.fx-muted{color:var(--fx-muted-fg)}
+.fx-card{background:var(--fx-card);border:1px solid var(--fx-border);border-radius:16px;box-shadow:var(--fx-shadow)}
+
+/* Header */
+.fx-header{position:sticky;top:0;z-index:40;background:color-mix(in oklch,var(--fx-bg) 95%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--fx-border)}
+.fx-header-row{display:flex;align-items:center;gap:20px;height:72px}
+.fx-logo{display:inline-flex;align-items:flex-start;gap:4px;font-family:var(--fx-display);font-size:32px;font-weight:600;letter-spacing:-.055em;line-height:1;color:var(--fx-primary)!important}
+.fx-logo i{width:12px;height:12px;margin-top:4px;border-radius:50% 50% 50% 0;background:var(--fx-gold);transform:rotate(-45deg);display:block}
+.fx-nav{display:none;gap:4px;margin-left:16px}
+.fx-nav a{position:relative;padding:8px 12px;font-size:14px;font-weight:500;color:var(--fx-muted-fg);border-radius:8px}
+.fx-nav a:hover{color:var(--fx-fg)}
+.fx-nav a[aria-current=page]{color:var(--fx-primary)}
+.fx-nav a[aria-current=page]::after{content:"";position:absolute;left:12px;right:12px;bottom:-17px;height:2px;border-radius:2px;background:var(--fx-gold)}
+.fx-header-tools{margin-left:auto;display:flex;align-items:center;gap:8px}
+.fx-search{display:none;position:relative}
+.fx-search input{height:40px;width:220px;border-radius:999px;border:1px solid transparent;background:color-mix(in oklch,var(--fx-muted) 80%,transparent);padding:0 14px 0 14px;font-size:14px}
+.fx-search input:focus{outline:none;border-color:color-mix(in oklch,var(--fx-primary) 25%,transparent);background:var(--fx-bg);box-shadow:0 0 0 3px color-mix(in oklch,var(--fx-primary) 10%,transparent)}
+.fx-menu{position:relative}
+.fx-menu summary{list-style:none;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;cursor:pointer}
+.fx-menu summary::-webkit-details-marker{display:none}
+.fx-menu summary:hover{background:var(--fx-muted)}
+.fx-menu-panel{position:absolute;right:0;top:48px;width:min(92vw,320px);background:var(--fx-bg);border:1px solid var(--fx-border);border-radius:16px;box-shadow:var(--fx-shadow);padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:4px}
+.fx-menu-panel a{padding:12px 14px;border-radius:10px;font-size:14px;font-weight:500}
+.fx-menu-panel a:hover,.fx-menu-panel a[aria-current=page]{background:var(--fx-muted)}
+@media(min-width:1024px){.fx-nav{display:flex}.fx-menu{display:none}}
+@media(min-width:1180px){.fx-search{display:block}}
+
+/* Footer */
+.fx-footer{margin-top:64px;padding-bottom:40px}
+.fx-footer-card{background:var(--fx-primary);color:var(--fx-on-primary);border-radius:24px;padding:36px 28px;box-shadow:var(--fx-shadow)}
+.fx-footer-card a{color:color-mix(in oklch,var(--fx-on-primary) 72%,transparent)}.fx-footer-card a:hover{color:var(--fx-on-primary)}
+.fx-footer-grid{display:grid;gap:32px;padding-bottom:32px;border-bottom:1px solid color-mix(in oklch,var(--fx-on-primary) 15%,transparent)}
+@media(min-width:900px){.fx-footer-grid{grid-template-columns:1.4fr 1fr 1fr}.fx-footer-card{padding:44px 40px}}
+.fx-footer-card .fx-logo{color:var(--fx-on-primary)!important}
+.fx-footer-line{margin-top:12px;max-width:320px;font-family:var(--fx-display);font-size:24px;line-height:1.2}
+.fx-footer h3{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--fx-gold-soft)}
+.fx-footer ul{margin-top:14px;display:grid;gap:10px;font-size:14px}
+.fx-footer-note{padding-top:20px;display:flex;flex-wrap:wrap;gap:8px 24px;justify-content:space-between;font-size:12px;color:color-mix(in oklch,var(--fx-on-primary) 58%,transparent)}
+
+/* Page intro and sections */
+.fx-main{padding-bottom:8px}
+.fx-intro{padding:40px 0 32px;border-bottom:1px solid var(--fx-border)}
+.fx-intro h1{margin-top:14px;font-size:clamp(2.2rem,5vw,3.8rem)}
+.fx-intro p.fx-lede{margin-top:16px;max-width:640px;font-size:17px;line-height:1.65;color:var(--fx-muted-fg)}
+.fx-section{padding:36px 0 0}
+.fx-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
+.fx-section-head h2{font-family:var(--fx-display);font-weight:500;font-size:clamp(1.7rem,3vw,2.3rem);letter-spacing:-.025em;color:var(--fx-primary)}
+.fx-section-head p{margin-top:6px;font-size:14px;color:var(--fx-muted-fg)}
+.fx-link{font-size:14px;font-weight:600;color:var(--fx-primary);white-space:nowrap}
+.fx-link:hover{text-decoration:underline}
+
+/* Home hero */
+.fx-hero{padding:36px 0 8px;display:grid;gap:28px}
+@media(min-width:960px){.fx-hero{grid-template-columns:1.25fr 1fr;align-items:center}}
+.fx-hero h1{font-size:clamp(2.4rem,5.4vw,4.2rem)}
+.fx-hero p.fx-lede{margin-top:18px;max-width:560px;font-size:17px;color:var(--fx-muted-fg);line-height:1.65}
+.fx-cta{margin-top:24px;display:flex;flex-wrap:wrap;gap:10px}
+.fx-btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 22px;border-radius:999px;font-size:14px;font-weight:600;border:1px solid transparent;cursor:pointer}
+.fx-btn-primary{background:var(--fx-primary);color:var(--fx-on-primary)!important}.fx-btn-primary:hover{background:var(--fx-primary-light)}
+.fx-btn-ghost{background:var(--fx-card);border-color:var(--fx-border);color:var(--fx-primary)!important}.fx-btn-ghost:hover{border-color:var(--fx-primary)}
+.fx-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+.fx-stat{padding:16px}
+.fx-stat b{display:block;font-family:var(--fx-display);font-size:34px;font-weight:600;letter-spacing:-.03em;color:var(--fx-primary);line-height:1.1}
+.fx-stat span{display:block;margin-top:4px;font-size:12px;font-weight:600;color:var(--fx-muted-fg)}
+.fx-stat .fx-na{font-size:16px;font-family:var(--fx-sans);font-weight:600;color:var(--fx-muted-fg)}
+.fx-fresh{margin-top:14px;display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--fx-muted-fg)}
+.fx-dot{width:8px;height:8px;border-radius:50%;background:var(--fx-muted-fg)}
+.fx-dot[data-state=fresh]{background:oklch(0.62 0.15 150)}.fx-dot[data-state=stale]{background:var(--fx-gold)}
+
+/* Creator cards */
+.fx-grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
+.fx-creator{display:flex;flex-direction:column;overflow:hidden;transition:transform .2s,box-shadow .2s}
+.fx-creator:hover{transform:translateY(-2px)}
+.fx-creator-media{position:relative;aspect-ratio:4/3;background:var(--fx-secondary);display:grid;place-items:center;overflow:hidden}
+.fx-creator-media img{width:100%;height:100%;object-fit:cover}
+.fx-initials{font-family:var(--fx-display);font-size:44px;font-weight:600;color:var(--fx-primary)}
+.fx-rank{position:absolute;left:10px;top:10px;min-width:34px;height:28px;padding:0 10px;display:grid;place-items:center;border-radius:999px;background:var(--fx-primary);color:var(--fx-on-primary);font-size:12px;font-weight:700}
+.fx-creator-body{padding:14px;display:grid;gap:6px}
+.fx-creator-body h3{font-size:15px;font-weight:700}
+.fx-creator-meta{font-size:12px;color:var(--fx-muted-fg)}
+.fx-chip{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;background:var(--fx-secondary);color:var(--fx-primary);font-size:11px;font-weight:600}
+.fx-chip-gold{background:var(--fx-gold-soft);color:var(--fx-gold-fg)}
+.fx-chips{display:flex;flex-wrap:wrap;gap:6px}
+.fx-value{font-size:13px;font-weight:700;color:var(--fx-primary)}
+
+/* Filters / forms */
+.fx-filters{display:grid;gap:10px;padding:14px;margin-top:24px}
+@media(min-width:760px){.fx-filters{grid-template-columns:2fr 1fr auto;align-items:end}}
+.fx-field{display:grid;gap:6px;font-size:12px;font-weight:600;color:var(--fx-muted-fg)}
+.fx-field input,.fx-field select{height:44px;border-radius:12px;border:1px solid var(--fx-input);background:var(--fx-card);padding:0 14px;font-size:14px;color:var(--fx-fg)}
+.fx-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
+.fx-pill{display:inline-flex;align-items:center;height:38px;padding:0 16px;border-radius:999px;border:1px solid var(--fx-border);background:var(--fx-card);font-size:13px;font-weight:600;color:var(--fx-muted-fg);cursor:pointer}
