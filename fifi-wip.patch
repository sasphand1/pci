+export function Logo(){
+  return <Link href="/" className="fx-logo" aria-label={`${BRAND.name} home`}>{BRAND.wordmark}<i aria-hidden="true"/></Link>;
+}
+
+export function FifiHeader(){
+  return <header className="fx-header"><div className="fx-wrap fx-header-row">
+    <Logo/>
+    <FifiNav items={NAV}/>
+    <div className="fx-header-tools">
+      <form className="fx-search" role="search" method="get" action="/creators"><input type="search" name="search" placeholder="Search creators…" maxLength={100} aria-label="Search creators"/></form>
+      <FifiMobileNav items={NAV}/>
+    </div>
+  </div></header>;
+}
+
+const EXPLORE=[{label:'Creators',href:'/creators'},{label:'Rankings',href:'/rankings'},{label:'Categories',href:'/categories'},{label:'Compare',href:'/compare'},{label:'Videos',href:'/videos'},{label:'Wall',href:'/wall'},{label:'Events',href:'/events'},{label:'Satellite',href:'/satellite'}];
+const ABOUT=[{label:'About',href:'/about'},{label:'Methodology',href:'/methodology'},{label:'Contact',href:'/contact'},{label:'Privacy',href:'/privacy'},{label:'Terms',href:'/terms'},{label:'Legal notice',href:'/legal-notice'}];
