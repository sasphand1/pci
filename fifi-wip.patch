+}
+export function Section({title,description,href,linkLabel='View all',children}:{title:string;description?:string;href?:string;linkLabel?:string;children:ReactNode}){
+  return <section className="fx-section"><div className="fx-section-head"><div><h2>{title}</h2>{description&&<p>{description}</p>}</div>{href&&<Link href={href} className="fx-link">{linkLabel} →</Link>}</div>{children}</section>;
+}
+export function Empty({title,message,children}:{title:string;message:string;children?:ReactNode}){
+  return <div className="fx-empty"><h3>{title}</h3><p>{message}</p>{children&&<div className="fx-cta">{children}</div>}</div>;
+}
+export function Avatar({name,src,size}:{name:string;src?:string|null;size?:'lg'}){
+  const safe=safeCreatorImage(src);
+  return <span className={size==='lg'?'fx-avatar':undefined}>{safe?<img src={safe} alt={name} loading="lazy" referrerPolicy="no-referrer"/>:<span className="fx-initials" aria-hidden="true">{initials(name)}</span>}</span>;
+}
+export function CreatorCardView({c}:{c:CreatorCard}){
+  const safe=safeCreatorImage(c.avatarUrl);
+  return <article className="fx-card fx-creator"><Link href={`/creators/${encodeURIComponent(c.slug)}`} className="fx-creator-media" aria-label={c.name}>
+    {safe?<img src={safe} alt="" loading="lazy" referrerPolicy="no-referrer"/>:<span className="fx-initials" aria-hidden="true">{initials(c.name)}</span>}
+    <span className="fx-rank">{c.tied?'=':''}#{c.rank}</span></Link>
+    <div className="fx-creator-body"><h3><Link href={`/creators/${encodeURIComponent(c.slug)}`}>{c.name}</Link></h3>
+      <p className="fx-value">{c.value===null?'Not available':`${formatCompact(c.value)} ${c.unit}`}</p>
+      <div className="fx-chips">{c.category&&<span className="fx-chip">{c.category}</span>}{c.platforms.map(p=><span key={p} className="fx-chip fx-chip-gold">{p==='youtube'?'YouTube':p==='instagram'?'Instagram':p}</span>)}</div></div></article>;
+}
+
+export function PersonTile({p}:{p:{slug:string;displayName:string;avatarUrl:string|null;categories:{slug:string;label:string}[];accounts:{platform:string}[]}}){
+  const safe=safeCreatorImage(p.avatarUrl);
+  const platforms=Array.from(new Set(p.accounts.map(a=>a.platform)));
+  return <article className="fx-card fx-creator"><Link href={`/creators/${encodeURIComponent(p.slug)}`} className="fx-creator-media" aria-label={p.displayName}>
+    {safe?<img src={safe} alt="" loading="lazy" referrerPolicy="no-referrer"/>:<span className="fx-initials" aria-hidden="true">{initials(p.displayName)}</span>}</Link>
+    <div className="fx-creator-body"><h3><Link href={`/creators/${encodeURIComponent(p.slug)}`}>{p.displayName}</Link></h3>
+      <div className="fx-chips">{p.categories.slice(0,2).map(c=><span key={c.slug} className="fx-chip">{c.label}</span>)}{platforms.map(x=><span key={x} className="fx-chip fx-chip-gold">{x==='youtube'?'YouTube':x==='instagram'?'Instagram':x}</span>)}</div></div></article>;
+}
