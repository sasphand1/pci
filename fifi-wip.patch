+    <div className="fx-footer-note"><p>© {new Date().getFullYear()} {BRAND.name} · {BRAND.product}</p><p>Figures come from published, public platform data.</p></div>
+  </div></div></footer>;
+}
+
+export function FifiFrame({children}:{children:React.ReactNode}){
+  return <div className="fx"><a className="fx-skip" href="#main">Skip to content</a><FifiHeader/><main id="main" className="fx-main">{children}</main><FifiFooter/></div>;
