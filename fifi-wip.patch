+
+/* Creator detail */
+.fx-profile{display:flex;flex-wrap:wrap;align-items:center;gap:20px;padding:36px 0 28px;border-bottom:1px solid var(--fx-border)}
+.fx-avatar{width:96px;height:96px;border-radius:50%;overflow:hidden;background:var(--fx-secondary);display:grid;place-items:center;flex:none;border:3px solid var(--fx-card);box-shadow:var(--fx-shadow)}
+.fx-avatar img{width:100%;height:100%;object-fit:cover}
+.fx-profile h1{font-size:clamp(2rem,4vw,3rem)}
+.fx-kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
+.fx-kpi{padding:16px}
+.fx-kpi small{display:block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--fx-gold-fg)}
+.fx-kpi b{display:block;margin-top:6px;font-family:var(--fx-display);font-size:30px;font-weight:600;color:var(--fx-primary);line-height:1.1}
+.fx-kpi span{display:block;margin-top:4px;font-size:12px;color:var(--fx-muted-fg)}
+.fx-table-wrap{overflow-x:auto;border:1px solid var(--fx-border);border-radius:16px;background:var(--fx-card)}
+.fx-table{width:100%;border-collapse:collapse;font-size:14px}
+.fx-table th{padding:12px 14px;text-align:left;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--fx-muted-fg);border-bottom:1px solid var(--fx-border);white-space:nowrap}
+.fx-table td{padding:12px 14px;border-bottom:1px solid var(--fx-border);vertical-align:top}
+.fx-table tr:last-child td{border-bottom:0}
+.fx-num{text-align:right;font-variant-numeric:tabular-nums}
+.fx-fine{margin-top:12px;font-size:12px;color:var(--fx-muted-fg);max-width:720px}
+.fx-two{display:grid;gap:14px}
+@media(min-width:860px){.fx-two{grid-template-columns:1fr 1fr}}
+.fx-prose{max-width:720px;display:grid;gap:14px;font-size:16px;line-height:1.7;color:var(--fx-fg)}
+.fx-map{margin-top:24px;border:1px solid var(--fx-border);border-radius:16px;overflow:hidden;background:var(--fx-card);height:min(70vh,560px)}
+.fx-map iframe{width:100%;height:100%;border:0;display:block}
+.fx-event-link{font-weight:600;color:var(--fx-primary)}
+.fx-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+@media(prefers-reduced-motion:reduce){.fx *{transition:none!important;animation:none!important}}
