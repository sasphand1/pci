@@ -0,0 +1,15 @@
+'use client';
+import Link from 'next/link';
+import {usePathname} from 'next/navigation';
+import {isActivePath} from '@/lib/fifi.mjs';
+type Item={label:string;href:string};
+
+export function FifiNav({items}:{items:readonly Item[]}){
+  const path=usePathname();
+  return <nav className="fx-nav" aria-label="Main navigation">{items.map(i=><Link key={i.href} href={i.href} aria-current={isActivePath(path,i.href)?'page':undefined}>{i.label}</Link>)}</nav>;
+}
+export function FifiMobileNav({items}:{items:readonly Item[]}){
+  const path=usePathname();
+  return <details className="fx-menu" key={path}><summary aria-label="Open navigation"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round"/></svg></summary>
+    <nav className="fx-menu-panel" aria-label="Mobile navigation">{items.map(i=><Link key={i.href} href={i.href} aria-current={isActivePath(path,i.href)?'page':undefined}>{i.label}</Link>)}</nav></details>;
+}
