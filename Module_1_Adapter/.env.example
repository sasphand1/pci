NODE_ENV=development
DB_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://pci:CHANGE_ME_URL_SAFE_PASSWORD@localhost:5432/pci
REDIS_URL=redis://localhost:6379
YOUTUBE_API_KEY=
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_DAILY_SOFT_LIMIT=8000
SYNC_VIDEOS_PER_CHANNEL=50
PUBLIC_CACHE_TTL_SECONDS=300
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX
LOG_HMAC_KEY=CHANGE_ME_64_HEX
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
DEV_BYPASS_TURNSTILE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=0
WALL_MESSAGE_RETENTION_DAYS=7
ADMIN_SESSION_HOURS=8
ADMIN_IDLE_MINUTES=30
WALL_SESSION_DAYS=7
# Meta Graph API: use a long-lived authorized credential; rotate before expiry.
# Never publish the token in frontend code or screenshots.
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_OWNER_ID=17841404672317181
INSTAGRAM_SYNC_ENABLED=false

# Experimental combined rankings: enable only after YouTube policy authorization
CROSS_PLATFORM_PUBLIC_ENABLED=false

# Daily 09:00 update runs inside the API process on Hostinger
RUN_WORKER_IN_API=true
# PCI Hub: rankings read the hub (default). Set to false only as an emergency rollback to the old table.
PCI_INGEST_RANKING=true
# Explicit opt-in only after Instagram public HTTP use is verified as permitted.
PCI_INSTAGRAM_HTTP_AVATARS=false

# ---- Satify Hub: Copernicus (free account at ecmwf.int; accept each dataset licence once on its website) ----
# ADS key: https://ads.atmosphere.copernicus.eu/how-to-api (CAMS air quality)
COPERNICUS_ADS_KEY=
# EWDS key: https://ewds.climate.copernicus.eu/how-to-api (GloFAS river flow). Falls back to the ADS key if empty.
COPERNICUS_EWDS_KEY=

# ---- Satify Hub (WhatsApp packs) ----
# dry_run (default) logs every message instead of sending it. Switch to live after a successful test.
SATIFY_DELIVERY_MODE=dry_run
# Contact shown to MET Norway in the User-Agent (their terms ask for one): a URL or email.
SATIFY_CONTACT=
# WhatsApp Cloud API (Meta Business → WhatsApp → API Setup). Never paste these into the admin panel.
WHATSAPP_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: WHATSAPP_GRAPH_VERSION=v23.0  SATIFY_WA_TEMPLATE=satify_alert  SATIFY_WA_TEMPLATE_LANG=en
