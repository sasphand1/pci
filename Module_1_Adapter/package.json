{
  "name": "pakistan-creator-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file=.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node --env-file=.env --import tsx src/cli/migrate.ts",
    "reset:owner": "node --env-file=.env --import tsx src/cli/reset-owner.ts",
    "create:owner": "node --env-file=.env --import tsx src/cli/create-owner.ts",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/unit/*.test.ts tests/engine/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration/smoke.test.ts",
    "check": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "npm run build",
    "test:db": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/integration/bucket.test.ts tests/integration/refresh.test.ts tests/integration/publish.test.ts tests/integration/public.test.ts tests/integration/overview.test.ts",
    "backfill:registry": "node --env-file=.env --import tsx src/cli/backfill-registry.ts",
    "smoke:live": "node --env-file=.env --import tsx scripts/live-smoke.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "engine.io": "6.6.12"
  }
}
